# ============================================
# 西南大王后端 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================

# ---- JWT 密钥 (请修改为随机字符串) ----
SECRET_KEY=your-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./xinan_dawang.db

# ---- LLM API 密钥 (至少配置一个) ----
# DeepSeek (推荐，便宜好用): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 (阿里云): https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_MODEL=qwen-plus

# Claude (Anthropic): https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# 默认使用的 LLM 提供商: deepseek | dashscope | anthropic
LLM_PROVIDER=deepseek

# ---- 推送通知 (可选) ----
# Firebase Cloud Messaging: https://console.firebase.google.com/
# FCM_SERVER_KEY=your-fcm-server-key-here

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000
